{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meeting Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "statement",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "owner_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_maker_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}