{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stableagent/mentor-framework/blob/main/schemas/context-selection-result.schema.json",
  "title": "Mentor Framework Context Selection Result",
  "type": "object",
  "required": [
    "request_id",
    "routing_status",
    "framework_version",
    "taxonomy_version",
    "normalized_request",
    "domains",
    "required_skills",
    "roles",
    "mentor_team",
    "authority_rules",
    "escalation_rules",
    "approval",
    "provenance",
    "representation"
  ],
  "properties": {
    "request_id": {"type": "string"},
    "routing_status": {
      "type": "string",
      "enum": [
        "ready",
        "approval-required",
        "clarification-required",
        "missing-skills",
        "escalation-required"
      ]
    },
    "framework_version": {"type": "string"},
    "taxonomy_version": {"type": "string"},
    "normalized_request": {
      "type": "object",
      "additionalProperties": true
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "priority"],
        "properties": {
          "id": {"type": "string"},
          "priority": {
            "type": "string",
            "enum": ["primary", "secondary"]
          }
        },
        "additionalProperties": false
      }
    },
    "required_skills": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "recommended_skills": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "roles": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "mentor_team": {
      "type": "object",
      "required": ["team_id", "lead_role", "members"],
      "properties": {
        "team_id": {"type": "string"},
        "lead_role": {"type": "string"},
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role"],
            "properties": {
              "role": {"type": "string"},
              "person_id": {"type": "string"},
              "status": {
                "type": "string",
                "enum": [
                  "fixed",
                  "approved",
                  "pre-authorized",
                  "approval-required",
                  "external-review"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "authority_rules": {
      "type": "array",
      "items": {"type": "string"}
    },
    "escalation_rules": {
      "type": "array",
      "items": {"type": "string"}
    },
    "missing_skills": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "approval": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not-required", "required", "approved", "rejected"]
        },
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "selection_rationale": {
      "type": "array",
      "items": {"type": "string"}
    },
    "excluded_context": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provenance": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {"type": "string"},
        "framework_commit": {"type": "string"},
        "taxonomy_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "representation": {
      "type": "object",
      "required": ["format"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["json", "toon", "markdown"]
        },
        "toon_version": {"type": "string"},
        "token_count": {"type": "integer", "minimum": 0},
        "tokenizer": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
