{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meeting Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "source",
        "document",
        "data",
        "user-statement",
        "mentor-analysis",
        "external-reference"
      ]
    },
    "description": {
      "type": "string"
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "source_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "captured_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reliability": {
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ]
    }
  }
}