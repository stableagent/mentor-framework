{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stableagent/mentor-skills/schemas/user-identity.schema.json",
  "title": "Registered User Identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_id",
    "given_name",
    "source"
  ],
  "properties": {
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "given_name": {
      "type": "string",
      "minLength": 1
    },
    "family_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "source": {
      "enum": [
        "ai-registration-identity",
        "host-application-identity",
        "identity-provider"
      ]
    }
  }
}